{
  "update.mode": "none",
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[json]": {"editor.defaultFormatter": "j-brooke.fracturedjsonvsc"},
  "[jsonc]": {"editor.defaultFormatter": "j-brooke.fracturedjsonvsc"},
  "[properties]": {"editor.defaultFormatter": "foxundermoon.shell-format"},
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
  "[vue]": {"editor.defaultFormatter": "Vue.volar"},
  "[yaml]": {"editor.defaultFormatter": "redhat.vscode-yaml"},
  "astGrep.serverPath": "/usr/bin/ast-grep",
  "cSpell.enabledFileTypes": {"shellscript": true},
  "cSpell.language": "en,pt-BR,pt,lorem,en-GB,en-US",
  "cSpell.userWords": ["nushell", "pacman"],
  "diffEditor.ignoreTrimWhitespace": false,
  "dotnetAcquisitionExtension.existingDotnetPath": [
    {"extensionId": "ms-dotnettools.csharp", "path": "/usr/bin/dotnet"}
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.detectIndentation": false,
  "editor.fontFamily": "'Iosevka Nerd Font Mono', 'FiraCode Nerd Font Mono', 'Droid Sans Mono', 'monospace', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 18,
  "editor.guides.bracketPairs": true,
  "editor.minimap.renderCharacters": false,
  "editor.renderWhitespace": "boundary",
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "extensions.experimental.affinity": {"asvetliakov.vscode-neovim": 1},
  "files.associations": {"*.sql.rollback": "sql"},
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "firedbg.showWelcome": false,
  "fontshortcuts.defaultTerminalFontSize": 14,
  "git.openRepositoryInParentFolders": "always",
  "glassit.alpha": 245,
  "javascript.format.semicolons": "insert",
  "languageToolLinter.diagnosticSeverity": "information",
  "languageToolLinter.languageTool.motherTongue": "pt-BR",
  "languageToolLinter.plainText.languageIds": ["plaintext", "typst"],
  "notebook.cellToolbarLocation": {
    "default"         : "right",
    "jupyter-notebook": "left"
  },
  "notebook.output.scrolling": true,
  "npm.packageManager": "bun",
  "redhat.telemetry.enabled": false,
  "rust-analyzer.cargo.targetDir": true,
  // "rust-analyzer.checkOnSave.command": "clippy",
  "security.workspace.trust.untrustedFiles": "open",
  "shebang.associations": [
    {"language": "nushell", "pattern": "^#!\\s*\/?.*\\bnu\\b"}
  ],
  "shellcheck.customArgs": ["-x"],
  "terminal.explorerKind": "external",
  "terminal.external.linuxExec": "ghostty",
  "terminal.integrated.defaultProfile.linux": "Nushell",
  "terminal.integrated.fontFamily": "'Iosevka Nerd Font', 'FiraCode Nerd Font', 'Droid Sans Mono', 'monospace', monospace",
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.localEchoExcludePrograms": [
    "vim"   , "vi"    , "nano"  , "micro" , "tmux"  , "zellij", "nvim"
  ],
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "typescript.format.semicolons": "insert",
  "window.commandCenter": true,
  "window.newWindowProfile": "Default",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0,
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.editor.empty.hint": "hidden",
  "workbench.iconTheme": "catppuccin-mocha",
  "languageToolLinter.languageTool.preferredVariants": "pt-BR",
  "languageToolLinter.lintOnOpen": true,
  "languageToolLinter.languageTool.level": "picky",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "docker.extension.enableComposeLanguageServer": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "mise.configureExtensionsAutomatically": true
}
