[user]
	name = Helton Reis
	useConfigOnly = true

[commit]
	gpgsign = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pull]
	rebase = true

[init]
	defaultBranch = master

[include]
	path = .work.gitconfig

[safe]
	directory = /opt/flutter

[push]
	autoSetupRemote = true

[core]
	fsmonitor = true
	untrackedcache = true
	pager = delta
	attributesfile = ~/.gitattributes

[interactive]
	diffFilter = delta --color-only
[add.interactive]
	useBuiltin = false

[merge]
	tool = nvim
[mergetool "nvim"]
	cmd = nvim -c "DiffviewOpen"
[mergetool]
	prompt = false

[diff]
	colorMoved = default

[include]
	path = ~/.config/delta/themes/catppuccin.gitconfig

[delta]
	navigate = true
	light = false
	syntax-theme = Catppuccin Mocha
	features = catppuccin-mocha

[diff "hex"]
	textconv = hexdump -Cv
	binary = true

# Difftastic aliases, so `git dlog` is `git log` with difftastic and so on.
[alias]
	# View changes from recent commits on the current branch with difftastic
	syntaxlog = -c diff.external=difft log --ext-diff
	# View changes from the most recent commit with difftastic
	syntaxshow = -c diff.external=difft show --ext-diff
	# View uncommitted changes with difftastic
	syntaxdiff = -c diff.external=difft diff

[alias]
	amend = commit --amend --no-edit
	initial = commit -m 'initial commit'
	stashm = stash push -Sm
	fetcha = fetch --all
	pulla = pull --autostash
	remotes = ! git remote | fzf --preview 'git remote -v show -n {}'
	remotesu = ! git remote | fzf --preview 'git remote -v show {}'
	amerge = merge --abort
	arebase = rebase --abort
