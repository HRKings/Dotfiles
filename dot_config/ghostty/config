theme = catppuccin-mocha.conf

# Font
font-family = "Iosevka Nerd Font"
font-size = 16

# Aesthetics
background-opacity = 0.85
background-blur = 25

# Window
window-width = 140
window-height = 30
maximize = true

window-padding-x = 14
window-padding-y = 14
resize-overlay = never

gtk-tabs-location = bottom

# Shell
shell-integration-features = true
command = /usr/bin/env nu

keybind = ctrl+arrow_up=jump_to_prompt:-1
keybind = ctrl+arrow_up=jump_to_prompt:+1

# Scrollback view
keybind = ctrl+alt+key_f=write_screen_file:open
keybind = ctrl+shift+key_s=write_screen_file:paste

# Misc
bell-features = system,audio,attention,title,border
keybind = ctrl+alt+key_w=close_surface
keybind = ctrl+shift+key_k=toggle_tab_overview

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

